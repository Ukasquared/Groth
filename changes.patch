+import Reveal from "./Reveal";
+import WomanImg from "@/assets/WomanImg.jpg";
+
+const WorkflowCard = () => {
+  return (
+    <Reveal delay={0.6} className="lg:col-span-2">
+      <div className="relative flex min-h-[320px] flex-col justify-start overflow-hidden rounded-3xl p-6 sm:min-h-[360px] sm:p-8 md:min-h-[400px] md:p-10">
+        <img
+          alt="Professional using app"
+          className="absolute inset-0 z-0 h-full w-full object-cover"
+          src={WomanImg}
+        />
+
+        <div className="absolute inset-0 z-10 bg-gradient-to-r from-black/50 via-black/20 to-transparent" />
+
+        <div className="relative z-20 max-w-sm">
+          <h2 className="mb-3 text-xl font-bold leading-tight sm:text-2xl md:text-3xl">
+            Unlock clear, shared workflows.
+          </h2>
+
+          <p className="text-sm text-gray-200 sm:text-base">
+            Bring teams, tools, and updates into one connected workspace.
+          </p>
+        </div>
+      </div>
+    </Reveal>
+  );
+};
+
+const TestimonialCard = () => {
+  return (
+    <Reveal delay={0.35}>
+      <div className="relative flex min-h-[320px] flex-col justify-between overflow-hidden rounded-3xl bg-gradient-to-br from-[#4b6d8c] to-[#36516a] p-6 sm:min-h-[360px] sm:p-8 md:min-h-[400px] md:p-10">
+        <div className="absolute left-8 top-8 text-6xl font-serif leading-none text-[#84cc16] opacity-80">
+          “
+        </div>
+
+        <div className="relative z-10 mt-12 sm:mt-14">
+          <p className="mb-8 text-base font-medium leading-tight sm:text-lg md:text-xl lg:text-2xl">
+            GROTH replaced three tools and finally gave our teams a shared understanding of what's
+            happening.
+          </p>
+
+          <div>
+            <p className="font-bold text-white">Emma Clark</p>
+
+            <p className="text-xs text-gray-300 sm:text-sm">Head of Operations, Klea</p>
+          </div>
+        </div>
+      </div>
+    </Reveal>
+  );
+};
+
+const FeatureCards = () => {
+  return (
+    <section id="features" className="mb-16 grid w-full grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-3">
+      <WorkflowCard />
+      <TestimonialCard />
+    </section>
+  );
+};
+
+export default FeatureCards;
